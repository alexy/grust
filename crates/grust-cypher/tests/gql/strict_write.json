    {
      "id": "reject-merge-without-explicit-identity",
      "feature": "reject-merge-without-explicit-identity",
      "requirement": "required",
      "statement": "MERGE (:Person {name: 'no id'})",
      "expectation": "rejected",
      "errorKind": "unsupported-feature"
