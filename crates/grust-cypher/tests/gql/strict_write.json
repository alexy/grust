    {
      "id": "reject-unresolved-edge-endpoint-write",
      "feature": "reject-unresolved-edge-endpoint-write",
      "requirement": "required",
      "statement": "MATCH (a:Person {id: 'p1'}) CREATE (a)-[:KNOWS]->(b)",
