      "expectation": "supported"
    },
    {
      "id": "reject-create-node-without-explicit-identity",
      "feature": "reject-create-node-without-explicit-identity",
      "requirement": "required",
      "statement": "CREATE (:Person {name: 'no id'})",
      "expectation": "rejected",
