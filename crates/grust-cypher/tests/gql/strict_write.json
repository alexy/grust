      "requirement": "required",
      "statement": "CREATE (:Person {id: 'p1'})-[:KNOWS]->(:Person {id: 'p2'})",
      "expectation": "supported"
    },
    {
      "id": "delete-resolved-node",
      "feature": "delete-resolved-node",
      "requirement": "required",
      "statement": "MATCH (n:Person {id: 'p1'}) DELETE n",
      "expectation": "supported"
    },
    {
      "id": "match-delete-edge-resolved-endpoints",
      "feature": "match-delete-edge-resolved-endpoints",
